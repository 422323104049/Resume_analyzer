# ---------- Application ----------
APP_ENV=development
FLASK_DEBUG=0
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-long-random-value
SESSION_LIFETIME_HOURS=8
# Set to 1 when serving over HTTPS (required in production)
SESSION_COOKIE_SECURE=0

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=mysql123
MYSQL_DATABASE=resume_analyzer

# ---------- Uploads ----------
MAX_UPLOAD_MB=5

# ---------- OCR (Windows: path to tesseract.exe if not on PATH) ----------
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---------- Optional AI feedback (leave blank to use built-in analysis only) ----------
AI_API_KEY=
AI_API_URL=https://api.anthropic.com/v1/messages
AI_MODEL=claude-sonnet-5-5

# ---------- Optional authorized job-data provider (leave blank to use search links) ----------
JOB_API_PROVIDER=
JOB_API_KEY=
JOB_API_BASE_URL=

# ---------- Rate limiting ----------
RATELIMIT_STORAGE_URI=memory://
AUTH_RATE_LIMIT=10 per minute
ANALYSIS_RATE_LIMIT=20 per hour

# ---------- ATS weights (percent; normalized automatically, illustrative defaults) ----------
ATS_WEIGHT_SKILLS=35
ATS_WEIGHT_KEYWORDS=25
ATS_WEIGHT_EXPERIENCE=20
ATS_WEIGHT_EDUCATION=10
ATS_WEIGHT_STRUCTURE=10